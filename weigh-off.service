[Unit]
Description=The Weigh Off tracker
After=network.target

[Service]
Type=simple
# Adjust User and WorkingDirectory to wherever you cloned the repo on the box.
User=weighoff
WorkingDirectory=/opt/weigh-off-server
# Set your shared passphrase here. Keep it out of git (this file is not committed by default).
Environment=WEIGHOFF_PASSPHRASE=change-this-passphrase
Environment=WEIGHOFF_HOST=127.0.0.1
Environment=WEIGHOFF_PORT=8770
Environment=WEIGHOFF_DB=/opt/weigh-off-server/weighoff.db
ExecStart=/usr/bin/python3 /opt/weigh-off-server/server.py
Restart=on-failure
RestartSec=3
# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
